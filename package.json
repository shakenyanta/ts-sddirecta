{
  "name": "ts-sddirecta",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "node scripts/sync-version.mjs && vite",
    "dev:lite": "node scripts/dev-lite.mjs",
    "edition:test:prepare": "npm run build:exe && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-edition-test.ps1",
    "build": "node scripts/sync-version.mjs && vue-tsc && vite build",
    "build:exe": "node scripts/sync-version.mjs && tauri build --no-bundle",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-portable-release.ps1",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-portable-release.ps1",
    "update:test:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-update-test.ps1",
    "preview": "vite preview",
    "tauri": "node scripts/sync-version.mjs && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.0"
  }
}
